<Window x:Class="MarketCountdownPlugin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MarketCountdownPlugin"
        Title="Market Countdown" WindowStyle="SingleBorderWindow" 
        Width="800" Height="700" Background="{StaticResource WindowBg}" Foreground="{StaticResource TextFg}">
    
    <Window.DataContext>
        <local:MarketCountdownViewModel/>
    </Window.DataContext>

    <Grid>
        <DockPanel>
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="15" Margin="0,0,0,10">
                <TextBlock Text="MARKET COUNTDOWN" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextFg}"/>
                <TextBlock Text="{Binding TodayDate}" FontSize="14" Opacity="0.7"/>
            </StackPanel>

            <!-- Controls -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Padding="15,0,15,15" Spacing="10">
                <CheckBox Content="Dark Mode" IsChecked="{Binding IsDarkMode}"/>
                <CheckBox Content="24 Hour" IsChecked="{Binding Use24Hour}"/>
                <CheckBox Content="Sounds" IsChecked="{Binding AnnouncerSoundsEnabled}"/>
                <Button Content="Collapse All" Padding="10,5"/>
            </StackPanel>

            <!-- Markets Section -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBg}" Margin="15,0,15,15" Padding="15">
                <StackPanel Spacing="15">
                    <!-- London -->
                    <Border Background="{StaticResource MarketCardBg}" Padding="15" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="London" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MarketVM.LondonLocalTime}" FontSize="18"/>
                                <TextBlock Text="{Binding MarketVM.LondonHours}" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                <TextBlock Text="{Binding MarketVM.LondonStatus}" FontSize="14" FontWeight="Bold" Foreground="{Binding MarketVM.LondonStatus,Converter={StaticResource StatusToColor}}"/>
                                <ProgressBar Value="{Binding MarketVM.LondonProgress}" Height="6" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding MarketVM.LondonDisplay}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- New York -->
                    <Border Background="{StaticResource MarketCardBg}" Padding="15" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="New York" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MarketVM.NewYorkLocalTime}" FontSize="18"/>
                                <TextBlock Text="{Binding MarketVM.NewYorkHours}" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                <TextBlock Text="{Binding MarketVM.NewYorkStatus}" FontSize="14" FontWeight="Bold" Foreground="{Binding MarketVM.NewYorkStatus,Converter={StaticResource StatusToColor}}"/>
                                <ProgressBar Value="{Binding MarketVM.NewYorkProgress}" Height="6" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding MarketVM.NewYorkDisplay}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Sydney -->
                    <Border Background="{StaticResource MarketCardBg}" Padding="15" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sydney" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MarketVM.SydneyLocalTime}" FontSize="18"/>
                                <TextBlock Text="{Binding MarketVM.SydneyHours}" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                <TextBlock Text="{Binding MarketVM.SydneyStatus}" FontSize="14" FontWeight="Bold" Foreground="{Binding MarketVM.SydneyStatus,Converter={StaticResource StatusToColor}}"/>
                                <ProgressBar Value="{Binding MarketVM.SydneyProgress}" Height="6" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding MarketVM.SydneyDisplay}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Tokyo -->
                    <Border Background="{StaticResource MarketCardBg}" Padding="15" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tokyo" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MarketVM.TokyoLocalTime}" FontSize="18"/>
                                <TextBlock Text="{Binding MarketVM.TokyoHours}" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                <TextBlock Text="{Binding MarketVM.TokyoStatus}" FontSize="14" FontWeight="Bold" Foreground="{Binding MarketVM.TokyoStatus,Converter={StaticResource StatusToColor}}"/>
                                <ProgressBar Value="{Binding MarketVM.TokyoProgress}" Height="6" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding MarketVM.TokyoDisplay}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Next Event -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBg}" Margin="15,0,15,15" Padding="15" CornerRadius="5" Visibility="{Binding ShowNextEventToggle,Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Next Event" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding NextEventText}" FontSize="14"/>
                    <TextBlock Text="{Binding NextEventCountdown}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>

            <!-- Currency Filters -->
            <Expander DockPanel.Dock="Top" Header="Currency Filters" Background="{StaticResource CardBg}" Margin="15,0,15,15" Padding="15" IsExpanded="False">
                <WrapPanel>
                    <CheckBox Content="USD" IsChecked="{Binding ShowUSD}" Margin="0,0,15,10"/>
                    <CheckBox Content="EUR" IsChecked="{Binding ShowEUR}" Margin="0,0,15,10"/>
                    <CheckBox Content="GBP" IsChecked="{Binding ShowGBP}" Margin="0,0,15,10"/>
                    <CheckBox Content="CAD" IsChecked="{Binding ShowCAD}" Margin="0,0,15,10"/>
                    <CheckBox Content="CHF" IsChecked="{Binding ShowCHF}" Margin="0,0,15,10"/>
                    <CheckBox Content="AUD" IsChecked="{Binding ShowAUD}" Margin="0,0,15,10"/>
                    <CheckBox Content="CNY" IsChecked="{Binding ShowCNY}" Margin="0,0,15,10"/>
                    <CheckBox Content="NZD" IsChecked="{Binding ShowNZD}" Margin="0,0,15,10"/>
                    <CheckBox Content="JPY" IsChecked="{Binding ShowJPY}" Margin="0,0,15,10"/>
                </WrapPanel>
            </Expander>

            <!-- Impact Filters -->
            <Expander DockPanel.Dock="Top" Header="Impact Levels" Background="{StaticResource CardBg}" Margin="15,0,15,15" Padding="15" IsExpanded="False">
                <WrapPanel>
                    <CheckBox Content="High Impact" IsChecked="{Binding ShowHighImpact}" Margin="0,0,15,10"/>
                    <CheckBox Content="Medium Impact" IsChecked="{Binding ShowMediumImpact}" Margin="0,0,15,10"/>
                    <CheckBox Content="Low Impact" IsChecked="{Binding ShowLowImpact}" Margin="0,0,15,10"/>
                    <CheckBox Content="Holiday" IsChecked="{Binding ShowHolidayImpact}" Margin="0,0,15,10"/>
                </WrapPanel>
            </Expander>

            <!-- Events List -->
            <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding UpcomingEvents}" Background="{StaticResource CardBg}" Margin="15,0,15,15" Padding="15">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource MarketCardBg}" Padding="10" Margin="0,0,0,5" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Currency}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Time}" FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"/>
                                    <TextBlock Text="{Binding Impact}" FontSize="11" Opacity="0.7"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Forecast}"/>
                                    <TextBlock Text="{Binding Previous}" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
